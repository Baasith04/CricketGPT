# =============================================================================
# CricketGPT Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to Git or share publicly.
# =============================================================================

# Application environment (development / staging / production)
APP_ENV=development

# Supabase Project Configuration & JWT Authentication
# Base URL of your Supabase project (e.g. https://[YOUR-PROJECT-REF].supabase.co)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# Expected JWT issuer (defaults to ${SUPABASE_URL}/auth/v1)
SUPABASE_JWT_ISSUER=
# Expected JWT audience (defaults to "authenticated")
SUPABASE_JWT_AUDIENCE=authenticated
# Allowed signing algorithms (defaults to ES256,RS256; add HS256 only if using shared secret)
SUPABASE_JWT_ALGORITHMS=ES256,RS256
# Optional: JWKS cache expiration in seconds (default: 300)
SUPABASE_JWKS_CACHE_SECONDS=300
# Optional: Supabase JWT secret for symmetric HS256 fallback (leave empty if using asymmetric JWKS)
SUPABASE_JWT_SECRET=

# Supabase PostgreSQL Connection String
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@[host]:[port]/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Bounded database query execution timeout in seconds (default: 30; 0 to use server default)
DB_STATEMENT_TIMEOUT=30

# AI Provider Routing & Fallbacks
AI_PRIMARY_PROVIDER=groq
AI_PROVIDER_ORDER=groq,gemini,mistral,nvidia
AI_TIMEOUT=30
AI_MAX_TOKENS=1000

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Groq API (OpenAI-compatible fallback)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Mistral API (OpenAI-compatible fallback)
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest

# NVIDIA API (OpenAI-compatible fallback)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# CORS (comma-separated allowed origins; leave empty when no browser frontend is attached)
CORS_ALLOW_ORIGINS=

# Rate Limiting (uses Redis via RATE_LIMIT_STORAGE_URI / REDIS_URL for multi-instance, or shared SQLite WAL for multi-worker)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_RAG_SEARCH=60/minute
RATE_LIMIT_RAG_INGEST=10/minute
# Optional comma-separated trusted proxy CIDRs for X-Forwarded-For verification (auto-enabled for Render proxies when RENDER=true)
TRUSTED_PROXY_CIDRS=

# Hybrid RAG & Protected Ingestion
RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_EMBEDDING_DIMENSION=768
INGESTION_API_KEY=your-secret-ingestion-api-key

# Application-defined conservative routing boundary (NOT a claim about Gemini's actual training cutoff).
# Questions at or before this boundary can use Gemini directly for historical narratives;
# questions beyond this boundary are grounded strictly via Supabase SQL and pgvector RAG.
GEMINI_KNOWLEDGE_CUTOFF_DATE=2024-03-01
GEMINI_KNOWLEDGE_CUTOFF_SEASON=2023

# =============================================================================
# LangChain Integration (optional — existing pipeline is fully preserved when
# LANGCHAIN_ENABLED=false, which is the default)
# =============================================================================
# Set to true to enable LangChain retry/fallback/tool-calling layer
LANGCHAIN_ENABLED=false

# Maximum tool-call iterations before falling back to legacy router
LANGCHAIN_MAX_TOOL_ITERATIONS=5

# Retry settings for each provider attempt
LANGCHAIN_MAX_RETRIES=2
LANGCHAIN_RETRY_MIN_SECONDS=1
LANGCHAIN_RETRY_MAX_SECONDS=8

# Timeout per tool call in seconds
LANGCHAIN_TOOL_TIMEOUT_SECONDS=15

# Whether to try fallback providers when primary fails
LANGCHAIN_FALLBACK_ENABLED=true
