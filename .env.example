# =============================================================================
# CricketGPT Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to Git or share publicly.
# =============================================================================

# Application environment (development / staging / production)
APP_ENV=development

# Supabase PostgreSQL Connection String
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@[host]:[port]/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres?sslmode=require

# AI Provider Routing & Fallbacks
AI_PRIMARY_PROVIDER=groq
AI_PROVIDER_ORDER=groq,gemini,mistral,nvidia
AI_TIMEOUT=30
AI_MAX_TOKENS=1000

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Groq API (OpenAI-compatible fallback)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Mistral API (OpenAI-compatible fallback)
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest

# NVIDIA API (OpenAI-compatible fallback)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# CORS (comma-separated allowed origins; leave empty when no browser frontend is attached)
CORS_ALLOW_ORIGINS=

# Rate Limiting (uses Redis via RATE_LIMIT_STORAGE_URI / REDIS_URL for multi-instance, or shared SQLite WAL for multi-worker)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_RAG_SEARCH=60/minute
RATE_LIMIT_RAG_INGEST=10/minute
# Optional comma-separated trusted proxy CIDRs for X-Forwarded-For verification (auto-enabled for Render proxies when RENDER=true)
TRUSTED_PROXY_CIDRS=

# Hybrid RAG & Protected Ingestion
RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_EMBEDDING_DIMENSION=768
INGESTION_API_KEY=your-secret-ingestion-api-key

# Application-defined conservative routing boundary (NOT a claim about Gemini's actual training cutoff).
# Questions at or before this boundary can use Gemini directly for historical narratives;
# questions beyond this boundary are grounded strictly via Supabase SQL and pgvector RAG.
GEMINI_KNOWLEDGE_CUTOFF_DATE=2024-03-01
GEMINI_KNOWLEDGE_CUTOFF_SEASON=2023
